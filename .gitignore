# ==========================================
# CampusPrice - Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Operating System & IDE junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Node.js / Frontend / Backend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Python / AI Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases & Local runtime storage
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
/backend/data/*.sqlite
/backend/data/*.db

# Generated data files (synthetic outputs / caches, keep specs)
/ai_service/data/*.csv
!/ai_service/data/.gitkeep
/ai_service/output/
/ai_service/models_cache/
