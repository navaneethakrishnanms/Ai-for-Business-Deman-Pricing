# CampusPrice AI Service – Environment Configuration
# Copy to .env and fill in values. .env is git-ignored.

# ── Server ────────────────────────────────────────────────────────────────────
AI_PORT=8001
AI_HOST=0.0.0.0

# ── Auth (static demo token) ──────────────────────────────────────────────────
# Set AUTH_DISABLED=true for local dev (no token needed)
OWNER_TOKEN=demo-owner-token
AUTH_DISABLED=true

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ── Gate probabilities ────────────────────────────────────────────────────────
PILOT_MIN_PROB=0.6

# ── Rate limiting (student endpoint, per IP per minute) ──────────────────────
STUDENT_RATE_LIMIT_PER_MIN=60

# ── LLM (optional – service works offline with rule-based fallback) ───────────
# LLM_PROVIDER=groq            # groq | gemini | openai
# LLM_API_KEY=your-groq-or-other-api-key
# LLM_MODEL=openai/gpt-oss-120b
