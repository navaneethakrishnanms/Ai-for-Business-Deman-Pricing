        "properties": {
          "combo_id": {
            "type": "string",
            "title": "Combo Id"
          },
          "discount_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Discount Pct"
          }
        },
        "type": "object",
        "required": [
          "combo_id",
          "discount_pct"
        ],
        "title": "ComboChange"
      },
      "ComboEvaluateRequest": {
        "properties": {
          "main_item_id": {
            "type": "string",
