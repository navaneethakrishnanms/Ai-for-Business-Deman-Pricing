          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "portion_size_g": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portion Size G"
          }
        },
        "type": "object",
        "required": [
          "item_id"
        ],
        "title": "ItemChange"
      },
      "OverrideRequest": {
        "properties": {
          "rec_id": {
            "type": "string",
            "title": "Rec Id"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "edited_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Value"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "rec_id",
          "decision"
        ],
        "title": "OverrideRequest"
      },
      "PredictRequest": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          },
          "portion_size_g": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Portion Size G"
          },
          "discount_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Discount Pct"
          },
          "day_type": {
            "type": "string",
            "title": "Day Type"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "price",
          "portion_size_g",
          "discount_pct",
          "day_type"
        ],
        "title": "PredictRequest"
      },
      "RecommendRequest": {
        "properties": {
          "coverage_target": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Target"
          },
          "day_type_mix": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day Type Mix"
          },
          "include_frontier": {
            "type": "boolean",
            "title": "Include Frontier",
            "default": false
          }
        },
        "type": "object",
        "title": "RecommendRequest"
      },
      "Scenario": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "item_changes": {
            "items": {
              "$ref": "#/components/schemas/ItemChange"
            },
            "type": "array",
            "title": "Item Changes",
            "default": []
          },
          "combo_changes": {
            "items": {
              "$ref": "#/components/schemas/ComboChange"
            },
            "type": "array",
            "title": "Combo Changes",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Scenario"
      },
      "ScenariosCompareRequest": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "day_type_mix": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day Type Mix"
          }
        },
        "type": "object",
        "required": [
          "scenarios"
        ],
        "title": "ScenariosCompareRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
