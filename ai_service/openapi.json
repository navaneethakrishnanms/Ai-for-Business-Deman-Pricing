          },
          "addon_item_id": {
            "type": "string",
            "title": "Addon Item Id"
          },
          "discount_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Discount Pct"
          },
          "day_type": {
            "type": "string",
            "title": "Day Type",
            "default": "regular"
          }
        },
        "type": "object",
        "required": [
          "main_item_id",
          "addon_item_id",
          "discount_pct"
        ],
        "title": "ComboEvaluateRequest"
      },
      "GuardrailsUpdate": {
        "properties": {
          "margin_floor_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
