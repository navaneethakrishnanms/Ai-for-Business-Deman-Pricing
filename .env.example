# ==========================================
# CampusPrice Root Environment Variables Template
# Copy this file to .env in each corresponding service directory
# ==========================================

# -----------------
# 1. Frontend (.env in /frontend)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=CampusPrice Copilot
VITE_APP_ENV=development

# -----------------
# 2. Node Backend (.env in /backend)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
DATABASE_URL=file:./data/campusprice.sqlite
LOG_LEVEL=debug

# -----------------
# 3. Python AI Service (.env in /ai_service)
# -----------------
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# Optional LLM Key for scenario narratives and student offer copywriting
# (System strictly operates with offline heuristic fallback if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
